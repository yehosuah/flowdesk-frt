{
  "name": "flowdesk-frt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/suite.xml --coverage.reportsDirectory=reports/coverage",
    "test:integration:ci": "vitest run src/tests/clients/ClientFlow.spec.ts src/tests/suppliers/SupplierFlow.spec.ts --reporter=default --reporter=junit --outputFile.junit=reports/integration.xml",
    "test:regression:ci": "vitest run src/tests/core/TaxBreakdown.spec.ts src/tests/core/permissions.spec.ts src/tests/core/authStorage.spec.ts --reporter=default --reporter=junit --outputFile.junit=reports/regression.xml"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.16",
    "driver.js": "^1.8.0",
    "lucide-vue-next": "^0.469.0",
    "marked": "^18.0.14",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
